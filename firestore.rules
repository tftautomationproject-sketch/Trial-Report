rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check test connection
    match /test/{document=**} {
      allow read, write: if true;
    }
    // Reports collection - shared between all users
    match /trial_reports/{document=**} {
      allow read, write: if true;
    }
    // App configuration (company name, logo, header defaults)
    match /app_config/{document=**} {
      allow read, write: if true;
    }
    // General match-all for application collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
